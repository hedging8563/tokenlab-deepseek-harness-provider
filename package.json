{
  "name": "@tokenlabai/dsh-provider",
  "version": "0.1.2",
  "description": "TokenLab provider bundle for DeepSeek Harness with native Responses, Messages and Chat routing plus multimodal and async tools.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "generated/model-routes.json",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.*",
    "routes:sync": "node scripts/sync-model-routes.mjs && node scripts/render-profile.mjs --write",
    "routes:check": "node scripts/render-profile.mjs --check",
    "routes:source-check": "node scripts/sync-model-routes.mjs --check",
    "check": "npm run routes:check && npm run typecheck && npm test",
    "prepack": "npm run build && npm run routes:check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tokenlab",
    "model-provider",
    "mcp",
    "multimodal",
    "async-ai"
  ],
  "author": "TokenLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedging8563/tokenlab-deepseek-harness-provider.git"
  },
  "homepage": "https://docs.tokenlab.sh/integrations/deepseek-harness",
  "bugs": {
    "url": "https://github.com/hedging8563/tokenlab-deepseek-harness-provider/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@tokenlabai/mcp-server": "0.6.18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
